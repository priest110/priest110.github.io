---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import avatar from '../assets/avatar-cartoon.png';
import landscape from '../assets/landscape.webp';
import { profile, experience, projects } from '../data/profile';

/** Splits "Took {Secrets Detection} and …" into plain text and linked phrases. */
const segments = (text: string, links: Record<string, string> = {}) =>
  text.split(/\{([^}]+)\}/).map((part, i) => (i % 2 === 1 && links[part] ? { text: part, href: links[part] } : { text: part }));

const year = new Date().getFullYear();
---
<Layout>
  <div class="layout">
    <header class="side">
      <div class="who">
        <div class="top r" style="--d:.1">
          <Image class="mini" src={avatar} width={152} height={152} alt="Cartoon portrait of Rui, chin in hand, one eyebrow raised" loading="eager" />
          <button class="theme" type="button" aria-label="Switch to dark mode" title="Switch theme">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
          </button>
        </div>
        <div class="r" style="--d:.25">
          <h1>{profile.name}</h1>
          <p class="role">{profile.role}</p>
          <p class="place">{profile.location}</p>
        </div>
        <div class="summary r" style="--d:.4">
          {profile.summary.map((line) => <p>{line}</p>)}
        </div>
        <nav class="spy r" style="--d:.55" aria-label="Sections">
          <a href="#experience" class="on">Experience</a>
          <a href="#projects">Projects</a>
        </nav>
      </div>
      <div class="contact r" style="--d:.7">
        <div class="row">
          <a class="cta" href={`mailto:${profile.email}`}>Get in touch</a>
          <a class="icon" href={profile.linkedin} rel="noopener" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5z" /></svg>
          </a>
          <a class="icon" href={profile.github} rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z" /></svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section id="experience" aria-labelledby="h-exp">
        <h2 class="sec r" id="h-exp" style="--d:.5">Experience</h2>
        <ol class="list">
          {experience.map((job, i) => (
            <li class="item r" style={`--d:${0.6 + i * 0.1}`}>
              <span class="when">{job.date}</span>
              <div>
                <h3>{job.title} <span>· {job.org}</span></h3>
                <p>{segments(job.text, job.links).map((seg) => (seg.href ? <a href={seg.href} rel="noopener">{seg.text}</a> : seg.text))}</p>
                {job.stack && <p class="stack">{job.stack.join(' · ')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="projects" aria-labelledby="h-proj">
        <h2 class="sec r" id="h-proj" style={`--d:${0.6 + experience.length * 0.1}`}>Projects</h2>
        <ul class="list">
          {projects.map((p, i) => (
            <li class="item r" style={`--d:${0.7 + (experience.length + i) * 0.1}`}>
              <span class="when">Open source</span>
              <div>
                <h3>{p.name} <span>· {p.context}</span><span class="arr" aria-hidden="true">↗</span></h3>
                <p>{p.text}</p>
                {p.stack && <p class="stack">{p.stack.join(' · ')}</p>}
                <a class="cover" href={p.url} rel="noopener" aria-label={`${p.name} on GitHub`}></a>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </div>

  <footer class="end">
    <div class="scene" id="scene">
      <div class="art">
        <div class="peek"><Image src={avatar} width={248} height={248} alt="" /></div>
        <div class="bubble" role="note">You made it to the end. <a href={`mailto:${profile.email}`}>Say hello?</a></div>
        <Image class="hills" src={landscape} widths={[800, 1600]} sizes="100vw" alt="" />
      </div>
    </div>
    <div class="fine"><span>© {year} {profile.name}</span><span>{profile.location}</span></div>
  </footer>
</Layout>

<script>
  import { initSite } from '../scripts/site';
  initSite();
</script>
