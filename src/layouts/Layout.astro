---
import '../styles/global.css';
import { profile } from '../data/profile';

// The browser tab shows just the name; link previews also show the role.
const title = profile.name;
const shareTitle = `${profile.name} · ${profile.role}`;
const url = profile.siteUrl + '/';
const image = `${profile.siteUrl}/og.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url,
  image,
  address: { '@type': 'PostalAddress', addressLocality: 'Braga', addressCountry: 'PT' },
  sameAs: [profile.linkedin, profile.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the saved theme before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t); } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={profile.description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#fcfaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#160d0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={profile.description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
